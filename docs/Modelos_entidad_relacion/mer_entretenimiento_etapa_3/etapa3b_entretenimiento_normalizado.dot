graph MER_Etapa3b {
    layout=neato; overlap=false; splines=line; outputorder=edgesfirst;
    label=<<B>MER - Etapa 3b: entretenimiento, normalizado</B><BR/><FONT POINT-SIZE="11">Subrayado = llave  |  Las relaciones N:M se convertirán en tablas intermedias al pasar al modelo relacional</FONT>>;
    labelloc=t; fontsize=20; fontname="Helvetica";
    node [fontname="Helvetica", fontsize=11, style=filled, fillcolor=white];
    edge [fontname="Helvetica", fontsize=13, color="#444444"];
    PELICULA [shape=box, width=1.8, height=0.65, fontsize=14, fillcolor="#dbe9f6", label=<<B>PELÍCULA</B>>, pos="0.00,-4.00!"];
    GENERO [shape=box, width=1.8, height=0.65, fontsize=14, fillcolor="#dbe9f6", label=<<B>GÉNERO</B>>, pos="9.50,-4.00!"];
    CLASIF [shape=diamond, width=1.7, height=0.95, fontsize=11, fillcolor="#fde9c9", label="clasificada_en", pos="4.75,-4.00!"];
    PELICULA -- CLASIF [label="N"]; CLASIF -- GENERO [label="M"];
    p1 [shape=ellipse, fontsize=11, fillcolor=white, label=<<U>id_película</U>>, pos="-3.40,-2.00!"];
    PELICULA -- p1 [color="#777777"];
    p2 [shape=ellipse, fontsize=11, fillcolor=white, label="título", pos="0.00,-0.70!"];
    PELICULA -- p2 [color="#777777"];
    p3 [shape=ellipse, fontsize=11, fillcolor=white, label="año_estreno", pos="3.40,-2.00!"];
    PELICULA -- p3 [color="#777777"];
    g1 [shape=ellipse, fontsize=11, fillcolor=white, label=<<U>nombre</U>>, pos="9.50,-1.70!"];
    GENERO -- g1 [color="#777777"];
    LIBRO [shape=box, width=1.8, height=0.65, fontsize=14, fillcolor="#dbe9f6", label=<<B>LIBRO</B>>, pos="0.00,-13.00!"];
    AUTOR [shape=box, width=1.8, height=0.65, fontsize=14, fillcolor="#dbe9f6", label=<<B>AUTOR</B>>, pos="10.00,-13.00!"];
    EDITORIAL [shape=box, width=1.8, height=0.65, fontsize=14, fillcolor="#dbe9f6", label=<<B>EDITORIAL</B>>, pos="0.00,-6.40!"];
    IDIOMA [shape=box, width=1.8, height=0.65, fontsize=14, fillcolor="#dbe9f6", label=<<B>IDIOMA</B>>, pos="0.00,-19.60!"];
    ESCRITO [shape=diamond, width=1.7, height=0.95, fontsize=11, fillcolor="#fde9c9", label="escrito_por", pos="5.00,-13.00!"];
    PUBLICA [shape=diamond, width=1.7, height=0.95, fontsize=11, fillcolor="#fde9c9", label="publica", pos="0.00,-9.70!"];
    ESTAEN [shape=diamond, width=1.7, height=0.95, fontsize=11, fillcolor="#fde9c9", label="está_en", pos="0.00,-16.30!"];
    LIBRO -- ESCRITO [label="N"]; ESCRITO -- AUTOR [label="M"];
    EDITORIAL -- PUBLICA [label="1"]; PUBLICA -- LIBRO [label="N"];
    IDIOMA -- ESTAEN [label="1"]; ESTAEN -- LIBRO [label="N"];
    o1 [shape=ellipse, fontsize=11, fillcolor=white, label="orden_autoría", pos="5.00,-15.40!"];
    ESCRITO -- o1 [color="#777777"];
    a1 [shape=ellipse, fontsize=11, fillcolor=white, label=<<U>nombre</U>>, pos="10.00,-10.70!"];
    AUTOR -- a1 [color="#777777"];
    e1 [shape=ellipse, fontsize=11, fillcolor=white, label=<<U>nombre</U>>, pos="3.30,-6.40!"];
    EDITORIAL -- e1 [color="#777777"];
    i1 [shape=ellipse, fontsize=11, fillcolor=white, label=<<U>código</U>>, pos="3.00,-19.60!"];
    IDIOMA -- i1 [color="#777777"];
    b1 [shape=ellipse, fontsize=11, fillcolor=white, label=<<U>id_libro</U>>, pos="-3.25,-9.75!"];
    LIBRO -- b1 [color="#777777"];
    b2 [shape=ellipse, fontsize=11, fillcolor=white, label="título", pos="-3.82,-10.44!"];
    LIBRO -- b2 [color="#777777"];
    b3 [shape=ellipse, fontsize=11, fillcolor=white, label="isbn", pos="-4.25,-11.24!"];
    LIBRO -- b3 [color="#777777"];
    b4 [shape=ellipse, fontsize=11, fillcolor=white, label="isbn13", pos="-4.51,-12.10!"];
    LIBRO -- b4 [color="#777777"];
    b5 [shape=ellipse, fontsize=11, fillcolor=white, label="núm_páginas", pos="-4.60,-13.00!"];
    LIBRO -- b5 [color="#777777"];
    b6 [shape=ellipse, fontsize=11, fillcolor=white, label="fecha_publicación", pos="-4.51,-13.90!"];
    LIBRO -- b6 [color="#777777"];
    b7 [shape=ellipse, fontsize=11, fillcolor=white, label="calificación_promedio", pos="-4.25,-14.76!"];
    LIBRO -- b7 [color="#777777"];
    b8 [shape=ellipse, fontsize=11, fillcolor=white, label="núm_calificaciones", pos="-3.82,-15.56!"];
    LIBRO -- b8 [color="#777777"];
    b9 [shape=ellipse, fontsize=11, fillcolor=white, label="núm_reseñas", pos="-3.25,-16.25!"];
    LIBRO -- b9 [color="#777777"];
}
