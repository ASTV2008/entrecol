graph MER_Etapa3a {
    layout=neato; overlap=false; splines=line; outputorder=edgesfirst;
    label=<<B>MER - Etapa 3a: entretenimiento, estado original</B><BR/><FONT POINT-SIZE="11">Subrayado = llave  |  Óvalo doble = atributo multivalor  |  Óvalo con hijos = atributo compuesto  |  Sin relaciones entre PELÍCULA y LIBRO</FONT>>;
    labelloc=t; fontsize=20; fontname="Helvetica";
    node [fontname="Helvetica", fontsize=11, style=filled, fillcolor=white];
    edge [fontname="Helvetica", fontsize=13, color="#444444"];
    PELICULA [shape=box, width=1.8, height=0.65, fontsize=14, fillcolor="#dbe9f6", label=<<B>PELÍCULA</B>>, pos="0,0!"];
    LIBRO [shape=box, width=1.8, height=0.65, fontsize=14, fillcolor="#dbe9f6", label=<<B>LIBRO</B>>, pos="15,0!"];
    p1 [shape=ellipse, fontsize=11, fillcolor=white, label=<<U>id_película</U>>, pos="-3.60,1.90!"];
    PELICULA -- p1 [color="#777777"];
    p2 [shape=ellipse, fontsize=11, fillcolor=white, label="título", pos="0.00,3.20!"];
    PELICULA -- p2 [color="#777777"];
    p2a [shape=ellipse, fontsize=11, fillcolor=white, label="nombre", pos="-1.90,5.30!"];
    p2 -- p2a [color="#777777"];
    p2b [shape=ellipse, fontsize=11, fillcolor=white, label="año", pos="1.90,5.30!"];
    p2 -- p2b [color="#777777"];
    p3 [shape=ellipse, fontsize=11, fillcolor=white, peripheries=2, label="géneros", pos="3.60,1.90!"];
    PELICULA -- p3 [color="#777777"];
    l1 [shape=ellipse, fontsize=11, fillcolor=white, label=<<U>id_libro</U>>, pos="15.00,5.60!"];
    LIBRO -- l1 [color="#777777"];
    l2 [shape=ellipse, fontsize=11, fillcolor=white, label="título", pos="12.20,4.85!"];
    LIBRO -- l2 [color="#777777"];
    l3 [shape=ellipse, fontsize=11, fillcolor=white, peripheries=2, label="autores", pos="10.15,2.80!"];
    LIBRO -- l3 [color="#777777"];
    l4 [shape=ellipse, fontsize=11, fillcolor=white, label="calificación_promedio", pos="9.40,0.00!"];
    LIBRO -- l4 [color="#777777"];
    l5 [shape=ellipse, fontsize=11, fillcolor=white, label="isbn", pos="10.15,-2.80!"];
    LIBRO -- l5 [color="#777777"];
    l6 [shape=ellipse, fontsize=11, fillcolor=white, label="isbn13", pos="12.20,-4.85!"];
    LIBRO -- l6 [color="#777777"];
    l7 [shape=ellipse, fontsize=11, fillcolor=white, label="código_idioma", pos="15.00,-5.60!"];
    LIBRO -- l7 [color="#777777"];
    l8 [shape=ellipse, fontsize=11, fillcolor=white, label="núm_páginas", pos="17.80,-4.85!"];
    LIBRO -- l8 [color="#777777"];
    l9 [shape=ellipse, fontsize=11, fillcolor=white, label="núm_calificaciones", pos="19.85,-2.80!"];
    LIBRO -- l9 [color="#777777"];
    l10 [shape=ellipse, fontsize=11, fillcolor=white, label="núm_reseñas", pos="20.60,-0.00!"];
    LIBRO -- l10 [color="#777777"];
    l11 [shape=ellipse, fontsize=11, fillcolor=white, label="fecha_publicación", pos="19.85,2.80!"];
    LIBRO -- l11 [color="#777777"];
    l12 [shape=ellipse, fontsize=11, fillcolor=white, label="editorial", pos="17.80,4.85!"];
    LIBRO -- l12 [color="#777777"];
}
