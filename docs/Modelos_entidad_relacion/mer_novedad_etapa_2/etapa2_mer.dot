// MER (notación de Chen) - Etapa 2: novedades (periodo, incapacidades y vacaciones)
graph MER_Etapa2 {
    layout=neato; overlap=false; splines=line; outputorder=edgesfirst;
    label=<<B>MER - Etapa 2: novedades</B><BR/><FONT POINT-SIZE="11">Subrayado = llave (en entidad débil: llave parcial)  |  Doble borde = entidad débil / relación identificadora  |  Atributos de EMPLEADO y catálogos: ver Etapa 1</FONT>>;
    labelloc=t; fontsize=20; fontname="Helvetica";
    node [fontname="Helvetica", fontsize=11, style=filled, fillcolor=white];
    edge [fontname="Helvetica", fontsize=13, color="#444444"];

    // ---- Entidades ----
    node [shape=box, width=1.9, height=0.65, fontsize=14, fillcolor="#dbe9f6"];
    EMPLEADO         [label=<<B>EMPLEADO</B>>, pos="-10.5,0!"];
    PERIODO          [label=<<B>PERIODO</B>>, pos="0,7!"];
    NOVEDAD_MENSUAL  [label=<<B>NOVEDAD_MENSUAL</B>>, peripheries=2, width=2.4, pos="0,0!"];
    INCAPACIDAD      [label=<<B>INCAPACIDAD</B>>, peripheries=2, pos="10,4!"];
    VACACION         [label=<<B>VACACIÓN</B>>, peripheries=2, pos="10,-4!"];

    // ---- Relaciones ----
    node [shape=diamond, width=1.7, height=0.95, fontsize=11, fillcolor="#fde9c9"];
    REGISTRA   [label="registra", peripheries=2, pos="-5.6,0!"];
    CORRESPONDE[label="corresponde", peripheries=2, pos="0,3.5!"];
    INCLUYE_I  [label="incluye", peripheries=2, pos="5.2,2.2!"];
    INCLUYE_V  [label="incluye", peripheries=2, pos="5.2,-2.2!"];

    EMPLEADO -- REGISTRA [label="1"];  REGISTRA -- NOVEDAD_MENSUAL [label="N", penwidth=2.2, color="black"];
    PERIODO -- CORRESPONDE [label="1"]; CORRESPONDE -- NOVEDAD_MENSUAL [label="N", penwidth=2.2, color="black"];
    NOVEDAD_MENSUAL -- INCLUYE_I [label="1"]; INCLUYE_I -- INCAPACIDAD [label="N", penwidth=2.2, color="black"];
    NOVEDAD_MENSUAL -- INCLUYE_V [label="1"]; INCLUYE_V -- VACACION    [label="N", penwidth=2.2, color="black"];

    // ---- Atributos ----
    node [shape=ellipse, width=0.5, height=0.4, fontsize=11, fillcolor=white];
    edge [color="#777777", fontsize=11];
    a0 [label=<<U>código</U>>, pos="-10.5,2.4!"];                 EMPLEADO -- a0;
    p1 [label=<<U>año</U>>, pos="-2.2,8.9!"];                  PERIODO -- p1;
    p2 [label=<<U>mes</U>>, pos="2.2,8.9!"];                   PERIODO -- p2;
    m1 [label="bonificación", pos="-3.0,-2.6!"];               NOVEDAD_MENSUAL -- m1;
    m2 [label="transporte", pos="0.6,-3.4!"];                  NOVEDAD_MENSUAL -- m2;
    i1 [label=<<U>fecha_inicio</U>>, pos="7.0,6.7!"];          INCAPACIDAD -- i1;
    i2 [label="fecha_fin", pos="10.6,6.9!"];                   INCAPACIDAD -- i2;
    i3 [label="días_reportados", pos="14.0,5.6!"];             INCAPACIDAD -- i3;
    v1 [label=<<U>fecha_inicio</U>>, pos="7.0,-6.7!"];         VACACION -- v1;
    v2 [label="fecha_fin", pos="10.6,-6.9!"];                  VACACION -- v2;
    v3 [label="días_reportados", pos="14.0,-5.6!"];            VACACION -- v3;
}
