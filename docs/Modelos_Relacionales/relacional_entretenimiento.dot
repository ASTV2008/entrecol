digraph Relacional_Entretenimiento {
  rankdir=LR; nodesep=0.45; ranksep=0.9; splines=polyline;
  label=<<B>Modelo relacional - Módulo Entretenimiento</B><BR/><FONT POINT-SIZE="11">PK = llave primaria  |  FK = llave foránea  |  UK = única  |  UK1 = única compuesta (junto con las demás UK1 de la tabla)  |  patas de gallo = lado "muchos"</FONT>>;
  labelloc=t; fontsize=20; fontname="Helvetica";
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [dir=both, arrowtail=tee, arrowhead=crow, color="#444444"];
  pelicula [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#d9efd5"><B>pelicula</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id_pelicula</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">titulo</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(200)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">anio_estreno</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT UNSIGNED</FONT></TD></TR></TABLE>>];
  genero [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#d9efd5"><B>genero</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id_genero</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">TINYINT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>UK</B></FONT></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(30)</FONT></TD></TR></TABLE>>];
  pelicula_genero [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#d9efd5"><B>pelicula_genero</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>PK FK</B></FONT></TD><TD ALIGN="LEFT">id_pelicula</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>PK FK</B></FONT></TD><TD ALIGN="LEFT">id_genero</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">TINYINT UNSIGNED</FONT></TD></TR></TABLE>>];
  editorial [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#d9efd5"><B>editorial</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id_editorial</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>UK</B></FONT></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(120)</FONT></TD></TR></TABLE>>];
  idioma [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#d9efd5"><B>idioma</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id_idioma</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">TINYINT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>UK</B></FONT></TD><TD ALIGN="LEFT">codigo</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(15)</FONT></TD></TR></TABLE>>];
  autor [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#d9efd5"><B>autor</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id_autor</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>UK</B></FONT></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(120)</FONT></TD></TR></TABLE>>];
  libro [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#d9efd5"><B>libro</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id_libro</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">titulo</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(300)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">isbn</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(13)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">isbn13</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(13)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">num_paginas</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">fecha_publicacion</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">calificacion_promedio</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">DECIMAL(3,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">num_calificaciones</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">num_resenas</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>FK</B></FONT></TD><TD ALIGN="LEFT">id_editorial</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>FK</B></FONT></TD><TD ALIGN="LEFT">id_idioma</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">TINYINT UNSIGNED</FONT></TD></TR></TABLE>>];
  libro_autor [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#d9efd5"><B>libro_autor</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>PK FK</B></FONT></TD><TD ALIGN="LEFT">id_libro</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>PK FK</B></FONT></TD><TD ALIGN="LEFT">id_autor</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">orden_autoria</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">TINYINT UNSIGNED</FONT></TD></TR></TABLE>>];
  pelicula -> pelicula_genero;
  genero -> pelicula_genero;
  editorial -> libro;
  idioma -> libro;
  libro -> libro_autor;
  autor -> libro_autor;
}
