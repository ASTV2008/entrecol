digraph Relacional_Nomina {
  rankdir=LR; nodesep=0.45; ranksep=0.9; splines=polyline;
  label=<<B>Modelo relacional - Módulo Nómina</B><BR/><FONT POINT-SIZE="11">PK = llave primaria  |  FK = llave foránea  |  UK = única  |  UK1 = única compuesta (junto con las demás UK1 de la tabla)  |  patas de gallo = lado "muchos"</FONT>>;
  labelloc=t; fontsize=20; fontname="Helvetica";
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [dir=both, arrowtail=tee, arrowhead=crow, color="#444444"];
  dependencia [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#cfe3f5"><B>dependencia</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id_dependencia</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>UK</B></FONT></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(60)</FONT></TD></TR></TABLE>>];
  cargo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#cfe3f5"><B>cargo</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id_cargo</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>FK UK1</B></FONT></TD><TD ALIGN="LEFT">id_dependencia</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>UK1</B></FONT></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(80)</FONT></TD></TR></TABLE>>];
  eps [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#cfe3f5"><B>eps</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id_eps</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>UK</B></FONT></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(60)</FONT></TD></TR></TABLE>>];
  arl [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#cfe3f5"><B>arl</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id_arl</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>UK</B></FONT></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(60)</FONT></TD></TR></TABLE>>];
  fondo_pension [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#cfe3f5"><B>fondo_pension</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id_fondo_pension</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>UK</B></FONT></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(60)</FONT></TD></TR></TABLE>>];
  empleado [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#cfe3f5"><B>empleado</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>PK</B></FONT></TD><TD ALIGN="LEFT">codigo</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">nombre_empleado</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">fecha_ingreso</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">sueldo</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">DECIMAL(14,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>FK</B></FONT></TD><TD ALIGN="LEFT">id_cargo</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>FK</B></FONT></TD><TD ALIGN="LEFT">id_eps</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>FK</B></FONT></TD><TD ALIGN="LEFT">id_arl</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>FK</B></FONT></TD><TD ALIGN="LEFT">id_fondo_pension</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT UNSIGNED</FONT></TD></TR></TABLE>>];
  periodo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#cfe3f5"><B>periodo</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id_periodo</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>UK1</B></FONT></TD><TD ALIGN="LEFT">anio</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>UK1</B></FONT></TD><TD ALIGN="LEFT">mes</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">TINYINT UNSIGNED</FONT></TD></TR></TABLE>>];
  novedad_mensual [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#cfe3f5"><B>novedad_mensual</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id_novedad</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>FK UK1</B></FONT></TD><TD ALIGN="LEFT">codigo</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>FK UK1</B></FONT></TD><TD ALIGN="LEFT">id_periodo</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">bonificacion</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">DECIMAL(14,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">transporte</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">DECIMAL(14,2)</FONT></TD></TR></TABLE>>];
  incapacidad [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#cfe3f5"><B>incapacidad</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id_incapacidad</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>FK UK1</B></FONT></TD><TD ALIGN="LEFT">id_novedad</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>UK1</B></FONT></TD><TD ALIGN="LEFT">fecha_inicio</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">fecha_fin</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">dias_reportados</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">TINYINT UNSIGNED</FONT></TD></TR></TABLE>>];
  vacacion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#cfe3f5"><B>vacacion</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id_vacacion</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>FK UK1</B></FONT></TD><TD ALIGN="LEFT">id_novedad</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>UK1</B></FONT></TD><TD ALIGN="LEFT">fecha_inicio</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">fecha_fin</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="9" COLOR="#8a1c1c"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">dias_reportados</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">TINYINT UNSIGNED</FONT></TD></TR></TABLE>>];
  dependencia -> cargo;
  cargo -> empleado;
  eps -> empleado;
  arl -> empleado;
  fondo_pension -> empleado;
  empleado -> novedad_mensual;
  periodo -> novedad_mensual;
  novedad_mensual -> incapacidad;
  novedad_mensual -> vacacion;
}
