# Copiar este archivo a ".env" y reemplazar los valores.
# Evitar los caracteres $ y comillas en las contraseñas (Compose los interpreta).
# Las claves SECRET_KEY y TOTP_ENCRYPTION_KEY deben conservarse por separado
# y respaldarse junto con el volumen de MariaDB.

# --- Base de datos (MariaDB) ---
DB_ROOT_PASSWORD=cambiar_root
DB_NAME=entrecol
DB_USER=entrecol_user
DB_PASSWORD=cambiar_password
DB_PORT=3306

# --- Backend ---
# Generar con: python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=cambiar_clave_larga_aleatoria
# Generar con: python3 -c 'import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
TOTP_ENCRYPTION_KEY=reemplazar_por_una_clave_fernet_generada
